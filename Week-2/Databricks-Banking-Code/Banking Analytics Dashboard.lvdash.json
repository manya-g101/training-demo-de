    {
      "name": "ff49b9db",
      "displayName": "KPI - Total Transactions",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS total_transactions\n",
        "FROM banking.gold.fact_transaction;"
      ]
    },
    {
      "name": "3f49590c",
      "displayName": "Aggregate Sum of Banking Transaction Values",
      "queryLines": [
        "SELECT\n",
        "    SUM(amount) AS total_transaction_amount\n",
        "FROM banking.gold.fact_transaction;"
      ]
    },
    {
      "name": "fae03f8c",
      "displayName": "average banking transaction value summary dataset",
      "queryLines": [
        "SELECT\n",
        "    ROUND(AVG(amount), 2) AS average_transaction_amount\n",
        "FROM banking.gold.fact_transaction;"
      ]
    },
    {
      "name": "ac8b6f7b",
      "displayName": "Transaction Success Metrics Overview",
      "queryLines": [
        "SELECT\n",
        "    COUNT(*) AS successful_transactions\n",
        "FROM banking.gold.fact_transaction\n",
        "WHERE transaction_status = 'SUCCESS';"
      ]
    },
    {
      "name": "dde16942",
      "displayName": "Success Rate Insights in Banking Transactions",
      "queryLines": [
        "SELECT\n",
        "    ROUND(\n",
        "        100.0 * SUM(\n",
        "            CASE\n",
        "                WHEN transaction_status = 'SUCCESS'\n",
        "                THEN 1\n",
        "                ELSE 0\n",
        "            END\n",
        "        ) / COUNT(*),\n",
        "        2\n",
        "    ) AS success_rate_percentage\n",
        "FROM banking.gold.fact_transaction;"
      ]
    },
    {
      "name": "888b5d01",
      "displayName": "Monthly Banking Transactions Summary",
      "queryLines": [
        "SELECT\n",
        "    d.year,\n",
        "    d.month,\n",
        "    d.month_name,\n",
        "    CONCAT(d.year, '-', LPAD(d.month, 2, '0')) AS month_year,\n",
        "    COUNT(*) AS transaction_count,\n",
        "    ROUND(SUM(f.amount), 2) AS total_amount\n",
        "FROM banking.gold.fact_transaction f\n",
        "JOIN banking.gold.dim_date d\n",
        "    ON f.date_key = d.date_key\n",
        "GROUP BY\n",
        "    d.year,\n",
        "    d.month,\n",
        "    d.month_name\n",
        "ORDER BY\n",
        "    d.year,\n",
        "    d.month;"
      ]
    },
    {
      "name": "ebb06218",
      "displayName": "Unique Customer Count Overview",
      "queryLines": [
        "SELECT COUNT(DISTINCT customer_id) AS total_customers\n",
        "FROM banking.gold.dim_customer;"
      ]
    },
    {
      "name": "f9bc25f1",
      "displayName": "Transaction Summary by Type with Counts and Amounts",
      "queryLines": [
        "SELECT\n",
        "    transaction_type,\n",
        "    COUNT(*) AS transaction_count,\n",
        "    ROUND(SUM(amount), 2) AS total_amount,\n",
        "    ROUND(AVG(amount), 2) AS average_amount\n",
        "FROM banking.gold.fact_transaction\n",
        "GROUP BY\n",
        "    transaction_type\n",
        "ORDER BY\n",
        "    total_amount DESC;"
      ]
    },
    {
      "name": "90107905",
      "displayName": "Transaction Status Frequency Summary Dataset",
      "queryLines": [
        "SELECT\n",
        "    transaction_status,\n",
        "    COUNT(*) AS transaction_count\n",
        "FROM banking.gold.fact_transaction\n",
        "GROUP BY\n",
        "    transaction_status\n",
        "ORDER BY\n",
        "    transaction_count DESC;"
      ]
    },
    {
      "name": "560775e1",
      "displayName": "Payment Method Transaction Insights",
      "queryLines": [
        "SELECT\n",
        "    payment_method,\n",
        "    COUNT(*) AS transaction_count,\n",
        "    ROUND(SUM(amount), 2) AS total_amount\n",
        "FROM banking.gold.fact_transaction\n",
        "GROUP BY\n",
        "    payment_method\n",
        "ORDER BY\n",
        "    transaction_count DESC;"
      ]
    },
    {
      "name": "3c4e618f",
      "displayName": "Transaction dataset",
      "queryLines": [
        "SELECT\n",
        "    f.transaction_id,\n",
        "    f.transaction_type,\n",
        "    f.amount,\n",
        "    f.payment_method,\n",
        "    f.transaction_status,\n",
        "    f.account_key,\n",
        "    f.customer_key,\n",
        "    f.branch_key,\n",
        "    f.date_key\n",
        "FROM banking.gold.fact_transaction f;"
      ]
    },
    {
      "name": "8febcfcf",
      "displayName": "Customer Regional Data",
      "queryLines": [
        "SELECT\n",
        "    c.customer_key,\n",
        "    CONCAT(c.first_name, ' ', c.last_name) AS customer_name,\n",
        "\n",
        "    INITCAP(TRIM(c.customer_segment)) AS customer_segment,\n",
        "\n",
        "    a.account_key,\n",
        "    INITCAP(TRIM(a.account_type)) AS account_type,\n",
        "    INITCAP(TRIM(a.account_status)) AS account_status,\n",
        "\n",
        "    f.transaction_key,\n",
        "    f.amount,\n",
        "    f.transaction_status,\n",
        "    f.transaction_type,\n",
        "    f.payment_method,\n",
        "\n",
        "    d.full_date,\n",
        "    d.year,\n",
        "    d.month,\n",
        "    d.month_name\n",
        "\n",
        "FROM banking.gold.fact_transaction f\n",
        "\n",
        "JOIN banking.gold.dim_customer c\n",
        "    ON f.customer_key = c.customer_key\n",
        "\n",
        "JOIN banking.gold.dim_account a\n",
        "    ON f.account_key = a.account_key\n",
        "\n",
        "JOIN banking.gold.dim_date d\n",
        "    ON f.date_key = d.date_key;"
      ]
    },
    {
      "name": "701817b7",
      "displayName": "top 10 customers",
      "queryLines": [
        "SELECT\n",
        "    c.customer_key,\n",
        "    CONCAT(c.first_name, ' ', c.last_name) AS customer_name,\n",
        "    INITCAP(TRIM(c.customer_segment)) AS customer_segment,\n",
        "    COUNT(*) AS transaction_count,\n",
        "    ROUND(SUM(f.amount), 2) AS total_transaction_amount\n",
        "FROM banking.gold.fact_transaction f\n",
        "JOIN banking.gold.dim_customer c\n",
        "    ON f.customer_key = c.customer_key\n",
        "GROUP BY\n",
        "    c.customer_key,\n",
        "    c.first_name,\n",
        "    c.last_name,\n",
        "    c.customer_segment\n",
        "ORDER BY\n",
        "    total_transaction_amount DESC\n",
        "LIMIT 10;"
      ]
    }
  ],
